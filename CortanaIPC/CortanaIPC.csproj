<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- .NET Standard 2.0: usable from .NET Framework 4.6.1+ and every modern .NET.
         net10.0: what CortanaXIHealer itself references. -->
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <RootNamespace>Cortana</RootNamespace>
    <AssemblyName>CortanaIPC</AssemblyName>
    <LangVersion>7.3</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <Version>1.0.0</Version>
    <Description>App-side link to the Windower "cortana" addon for Final Fantasy XI: live game state (player, party, entities, recasts, buffs, chat, combat, NPC dialogs) and commands (movement, targeting, chat, keys, NPC selling / replay).</Description>
  </PropertyGroup>

</Project>
